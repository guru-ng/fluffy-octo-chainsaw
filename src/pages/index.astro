---
import PostPreview from "@/components/blog/PostPreview.astro";
import { getMicrocmsPosts } from "@/data/microcms";
import { projects } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 3;

let allPostsByDate: Awaited<ReturnType<typeof getMicrocmsPosts>> = [];
try {
	const microPosts = await getMicrocmsPosts({ limit: MAX_POSTS, offset: 0 });
	allPostsByDate = microPosts.sort(
		(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
	);
} catch (error) {
	console.warn("[index] Failed to fetch from microCMS, showing no posts:", error);
}

const name = "Sanjeev";
const total = String(projects.length).padStart(2, "0");

const capabilities = [
	{
		title: "Frontend",
		text: "Responsive, accessible interfaces that are fast and easy to use.",
		color: "c3",
		tags: ["HTML / CSS / JS", "React", "Vue", "TypeScript", "Tailwind CSS"],
	},
	{
		title: "Flutter & mobile",
		text: "Cross-platform apps from a single codebase.",
		color: "c4",
		tags: ["Flutter", "Dart", "Cross-platform"],
	},
	{
		title: "Backend & automation",
		text: "The practical backend, tooling and automation to ship full-stack work.",
		color: "c5",
		tags: ["Node.js", "Python", "AI automation", "Git & GitHub", "CI/CD (learning)"],
	},
];

const values = [
	{ title: "Keep learning", text: "Every project teaches something new.", color: "acc" },
	{ title: "Ship what works", text: "Simple, finished and useful beats perfect.", color: "c2" },
	{ title: "Clear communication", text: "Plain words, clear goals, no surprises.", color: "c3" },
];
---

<PageLayout meta={{ title: "Home" }} wide>
	<div class="hm" id="hm">
		<div class="hm-prog" aria-hidden="true" id="hm-prog"></div>

		<!-- HERO -->
		<section class="hm-hero" id="home" aria-labelledby="hm-name">
			<div class="hm-wrap hm-hero-grid">
				<div id="hm-hero-text">
					<p class="hm-eyebrow hm-rv"><span class="hm-dot"></span> Based in Osaka, Japan</p>
					<h1 aria-label={name} class="hm-h1" id="hm-name">
						{
							name.split("").map((c, i) => (
								<span aria-hidden="true" class="hm-ch" style={`--i:${i}`}>
									{c}
								</span>
							))
						}
					</h1>
					<p class="hm-tag hm-rv">
						Frontend developer growing into full-stack, DevOps and AI automation. I build clean,
						useful apps and web experiences <em>with clarity and purpose.</em>
					</p>
					<div class="hm-cta hm-rv">
						<a class="pill pill-solid" href="#works">View Works <span aria-hidden="true" class="hm-arrow">↓</span></a>
						<a class="pill" href="/contact/">Let's talk</a>
					</div>
				</div>
				<div class="hm-portrait hm-rv" id="hm-portrait">
					<img
						alt="Portrait of Sanjeev Gurung"
						height="640"
						loading="eager"
						src={`${import.meta.env.BASE_URL}images/profile.jpg`}
						width="512"
					/>
				</div>
			</div>
			<a aria-label="Scroll to works" class="hm-hint" href="#works" id="hm-hint">
				<span>Scroll</span><i></i>
			</a>
		</section>

		<!-- WORKS: pinned, vertical scroll drives horizontal movement -->
		<section aria-labelledby="hm-works-title" class="hm-hz" id="works">
			<div class="hm-pin" id="hm-pin">
				<div class="hm-wrap">
					<div class="hm-sh hm-rv">
						<h2 class="hm-h2" id="hm-works-title"><span class="hm-mask">Works</span></h2>
						<p class="hm-lbl">
							<span aria-hidden="true" class="hm-cnt" id="hm-cnt">01 / {total}</span>
							<span class="hm-sr-hide">&nbsp;·&nbsp; Keep scrolling ↓</span>
						</p>
					</div>
				</div>
				<ul class="hm-row" id="hm-row" role="list">
					{
						projects.map((p, i) => (
							<li class="hm-card hm-rv" style={`--ca:var(--hm-ca-${i % 4})`}>
								<a class="hm-card-link" href={`/projects/#${p.id}`}>
									<div class={`hm-thumb hm-t${(i % 4) + 1}`}>
										<span>{p.short}</span>
									</div>
									<div class="hm-cb">
										<h3>{p.title}</h3>
										<p>{p.summary}</p>
										<div class="hm-chips">
											{p.tags.map((t) => (
												<span class={`chip ${t.color ? `chip-${t.color}` : ""}`}>{t.label}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
				<div class="hm-wrap hm-foot">
					<div aria-hidden="true" class="hm-track"><i id="hm-bar"></i></div>
				</div>
			</div>
		</section>

		<!-- ABOUT -->
		<section class="hm-sec" id="about" aria-labelledby="hm-about-title">
			<div class="hm-wrap">
				<div class="hm-sh hm-rv">
					<h2 class="hm-h2" id="hm-about-title"><span class="hm-mask">About</span></h2>
					<p class="hm-lbl">Osaka, Japan</p>
				</div>
				<div class="hm-about hm-rv">
					<p class="hm-lead">
						Hello! I'm Sanjeev Gurung, a developer based in Osaka, Japan. I specialize in <b><i>frontend</i></b> development,
						aspiring to be a full-stack developer and DevOps engineer.
					</p>
					<div>
						<p class="hm-body">
							I'm also exploring AI automation with Python and other tools, and I build apps and sites
							of my own alongside my day job.
						</p>
						<div class="hm-cta">
							<a class="pill" href="/about/">More about me</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CAPABILITIES -->
		<section class="hm-sec" aria-labelledby="hm-cap-title">
			<div class="hm-wrap">
				<div class="hm-sh hm-rv">
					<h2 class="hm-h2" id="hm-cap-title"><span class="hm-mask">Capabilities</span></h2>
				</div>
				<div class="hm-caps">
					{
						capabilities.map((c) => (
							<div class="hm-cap hm-rv" style={`--ca:var(--color-${c.color})`}>
								<h3>{c.title}</h3>
								<p>{c.text}</p>
								<div class="hm-chips">
									{c.tags.map((t) => (
										<span class={`chip chip-${c.color}`}>{t}</span>
									))}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- VALUES -->
		<section class="hm-sec" aria-labelledby="hm-val-title">
			<div class="hm-wrap">
				<div class="hm-sh hm-rv">
					<h2 class="hm-h2" id="hm-val-title"><span class="hm-mask">Values</span></h2>
				</div>
				<div class="hm-vals">
					{
						values.map((v) => (
							<div class="hm-val hm-rv">
								<h3 style={`color:var(--color-${v.color === "acc" ? "accent" : v.color})`}>
									{v.title}
								</h3>
								<p>{v.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- LATEST POSTS -->
		{
			allPostsByDate.length > 0 && (
				<section class="hm-sec" aria-labelledby="hm-posts-title">
					<div class="hm-wrap">
						<div class="hm-sh hm-rv">
							<h2 class="hm-h2" id="hm-posts-title">
								<span class="hm-mask">Latest posts</span>
							</h2>
							<a class="pill" href="/posts/">All posts</a>
						</div>
						<ul class="hm-posts" role="list">
							{allPostsByDate.map((p) => (
								<li class="hm-post hm-rv">
									<PostPreview post={p} />
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		<!-- CTA -->
		<section class="hm-sec hm-big" aria-labelledby="hm-cta-title">
			<div class="hm-wrap">
				<h2 class="hm-h2 hm-rv" id="hm-cta-title">Let's <span class="hm-hl">chat.</span></h2>
				<div class="hm-cta hm-rv" style="justify-content:center">
					<a class="pill pill-solid" href="/contact/">Let's talk</a>
					<a class="pill" href="#works">Works</a>
				</div>
			</div>
		</section>
	</div>
</PageLayout>

<style is:global>
	.hm {
		--hm-ca-0: var(--color-accent);
		--hm-ca-1: var(--color-c3);
		--hm-ca-2: var(--color-c4);
		--hm-ca-3: var(--color-c5);
		overflow-x: clip;
	}
	.hm-wrap {
		max-width: 75rem;
		margin: 0 auto;
		padding: 0 1.75rem;
		width: 100%;
	}
	.hm-sr-hide {
		display: inline;
	}
	/* progress bar */
	.hm-prog {
		position: fixed;
		inset: 0 0 auto 0;
		height: 3px;
		z-index: 60;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		pointer-events: none;
	}
	/* hero */
	.hm-hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding: 7rem 0 4rem;
	}
	.hm-hero-grid {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 3.5rem;
		align-items: center;
	}
	.hm-eyebrow {
		color: var(--color-mut);
		font-size: 15px;
		display: flex;
		gap: 10px;
		align-items: center;
	}
	.hm-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
		animation: hm-pulse 2.4s infinite;
	}
	@keyframes hm-pulse {
		0% {
			box-shadow: 0 0 0 0 var(--color-accent);
		}
		70%,
		100% {
			box-shadow: 0 0 0 10px transparent;
		}
	}
	.hm-h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(4.5rem, 13vw, 11.5rem);
		line-height: 0.9;
		letter-spacing: -0.03em;
		margin: 1.1rem 0 1.6rem;
		color: var(--color-accent-2);
	}
	.hm-ch {
		display: inline-block;
		opacity: 0;
		transform: translateY(0.55em) rotate(4deg);
		animation: hm-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
		animation-delay: calc(var(--i) * 70ms + 150ms);
	}
	@keyframes hm-rise {
		to {
			opacity: 1;
			transform: none;
		}
	}
	.hm-tag {
		font-size: clamp(1.15rem, 2.1vw, 1.5rem);
		max-width: 32ch;
		line-height: 1.4;
	}
	.hm-tag em {
		color: var(--color-mut);
		font-style: normal;
	}
	.hm-cta {
		display: flex;
		gap: 12px;
		margin-top: 2.1rem;
		flex-wrap: wrap;
	}
	.hm-arrow {
		display: inline-block;
		margin-left: 10px;
		animation: hm-nudge 2s ease-in-out infinite;
	}
	.pill:hover .hm-arrow {
		animation: none;
		transform: translateY(4px);
	}
	@keyframes hm-nudge {
		50% {
			transform: translateY(4px);
		}
	}
	.hm-portrait {
		aspect-ratio: 4 / 5;
		border-radius: 1.1rem;
		border: 1px solid var(--color-line);
		background: var(--color-card);
		overflow: hidden;
		max-width: 28rem;
		justify-self: end;
		width: 100%;
	}
	.hm-portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	#hm-hero-text,
	#hm-portrait {
		will-change: translate, opacity;
	}
	.hm-hint {
		position: absolute;
		left: 50%;
		bottom: 1.6rem;
		translate: -50% 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		color: var(--color-mut);
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.hm-hint i {
		display: block;
		width: 1px;
		height: 38px;
		background: linear-gradient(var(--color-accent), transparent);
		transform-origin: top;
		animation: hm-drip 1.8s ease-in-out infinite;
	}
	@keyframes hm-drip {
		0% {
			transform: scaleY(0);
		}
		50% {
			transform: scaleY(1);
		}
		100% {
			transform: scaleY(1);
			opacity: 0;
		}
	}
	/* section headers */
	.hm-sec {
		padding: 6rem 0;
		border-top: 1px solid var(--color-line);
	}
	.hm-sh {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1.25rem;
		flex-wrap: wrap;
		margin-bottom: 2.75rem;
	}
	.hm-h2 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-accent-2);
	}
	.hm-mask {
		display: inline-block;
		overflow: hidden;
		padding-bottom: 0.12em;
		vertical-align: bottom;
	}
	.hm-lbl {
		color: var(--color-mut);
		font-size: 15px;
	}
	.hm-cnt {
		font-variant-numeric: tabular-nums;
	}
	/* works: fallback = swipeable row; pinned mode when .hm-on */
	.hm-hz {
		border-top: 1px solid var(--color-line);
		padding: 5rem 0 3rem;
	}
	.hm-row {
		display: flex;
		gap: 22px;
		list-style: none;
		margin: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 6px max(1.75rem, calc((100vw - 75rem) / 2 + 1.75rem)) 18px;
		scrollbar-width: thin;
	}
	.hm-row > .hm-card {
		flex: 0 0 min(25rem, 78vw);
		scroll-snap-align: start;
	}
	.hm-on {
		padding: 0;
	}
	.hm-on .hm-pin {
		position: sticky;
		top: 0;
		height: 100svh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-top: 4rem;
	}
	.hm-on .hm-sh {
		margin-bottom: 1.75rem;
	}
	.hm-on .hm-row {
		overflow: visible;
		width: max-content;
		scroll-snap-type: none;
		will-change: transform;
	}
	.hm-foot {
		margin-top: 0.5rem;
		display: none;
	}
	.hm-on .hm-foot {
		display: block;
	}
	.hm-track {
		height: 3px;
		background: var(--color-line);
		border-radius: 3px;
		overflow: hidden;
	}
	.hm-track i {
		display: block;
		height: 100%;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}
	.hm-card {
		background: var(--color-card);
		border: 1px solid var(--color-line);
		border-top: 4px solid var(--ca, var(--color-edge));
		border-radius: 1.1rem;
		overflow: hidden;
		transition:
			transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
			border-color 0.3s;
	}
	.hm-card:hover,
	.hm-card:focus-within {
		transform: translateY(-6px);
		border-color: var(--color-mut);
		border-top-color: var(--ca);
	}
	.hm-card-link {
		display: block;
		color: inherit;
		text-decoration: none;
		height: 100%;
	}
	.hm-thumb {
		aspect-ratio: 16 / 10;
		display: grid;
		place-items: center;
		font-family: var(--font-serif);
		font-size: 2.6rem;
		color: #f2f1ee; /* >= 8.8:1 on the lightest gradient stop */
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: 0 1rem;
	}
	.hm-thumb span {
		display: block;
		will-change: translate;
	}
	.hm-thumb::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, transparent 40%, rgba(255, 255, 255, 0.12) 50%, transparent 60%);
		transform: translateX(-100%);
		transition: transform 0.8s;
	}
	.hm-card:hover .hm-thumb::after {
		transform: translateX(100%);
	}
	.hm-t1 {
		background: linear-gradient(135deg, #17230a, #2f4a0b);
	}
	.hm-t2 {
		background: linear-gradient(135deg, #0a1c28, #0f4260);
	}
	.hm-t3 {
		background: linear-gradient(135deg, #230d2b, #4c1a59);
	}
	.hm-t4 {
		background: linear-gradient(135deg, #2b1a0a, #5a3810);
	}
	.hm-cb {
		padding: 1.25rem 1.4rem 1.5rem;
	}
	.hm-cb h3 {
		font-size: 1.3rem;
		font-weight: 500;
		color: var(--color-accent-2);
	}
	.hm-cb p {
		color: var(--color-mut);
		font-size: 15px;
		margin-top: 4px;
	}
	.hm-chips {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-top: 14px;
	}
	/* about */
	.hm-about {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 4rem;
		align-items: start;
	}
	.hm-lead {
		font-size: clamp(1.4rem, 2.6vw, 2.1rem);
		line-height: 1.3;
	}
	.hm-body {
		color: var(--color-mut);
		font-size: 1.1rem;
		line-height: 1.55;
	}
	/* capabilities & values */
	.hm-caps,
	.hm-vals {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}
	.hm-cap {
		border-top: 4px solid var(--ca);
		padding-top: 1.4rem;
	}
	.hm-cap h3 {
		font-family: var(--font-serif);
		font-size: 2.25rem;
		font-weight: 400;
		line-height: 1.1;
		color: var(--color-accent-2);
	}
	.hm-cap p {
		color: var(--color-mut);
		margin: 0.5rem 0 1rem;
	}
	.hm-val h3 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2rem, 4vw, 3.25rem);
		line-height: 1.05;
	}
	.hm-val p {
		color: var(--color-mut);
		margin-top: 0.6rem;
		max-width: 26ch;
	}
	/* posts */
	.hm-posts {
		list-style: none;
		margin: 0;
		display: grid;
		gap: 1rem;
	}
	.hm-post {
		display: grid;
		gap: 0.5rem;
		grid-template-columns: auto 1fr;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-line);
	}
	/* CTA */
	.hm-big {
		text-align: center;
		padding: 8rem 0;
	}
	.hm-big .hm-h2 {
		font-size: clamp(3.25rem, 10vw, 9.5rem);
		margin-bottom: 0.5rem;
	}
	.hm-hl {
		color: var(--color-accent);
	}
	/* reveal-on-scroll, only when JS can run */
	@media (scripting: enabled) {
		.hm-rv {
			opacity: 0;
			transform: translateY(26px);
			transition:
				opacity 0.9s ease,
				transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
		}
		.hm-rv.hm-in {
			opacity: 1;
			transform: none;
		}
		.hm-card.hm-rv.hm-in:hover,
		.hm-card.hm-rv.hm-in:focus-within {
			transform: translateY(-6px);
		}
		.hm-mask > * {
			display: inline-block;
		}
	}
	/* tablet */
	@media (max-width: 1023px) {
		.hm-hero-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.hm-portrait {
			justify-self: start;
			max-width: 22rem;
			aspect-ratio: 1;
		}
		.hm-about {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.hm-caps,
		.hm-vals {
			grid-template-columns: 1fr;
		}
	}
	/* mobile */
	@media (max-width: 767px) {
		.hm-wrap {
			padding: 0 1.25rem;
		}
		.hm-sec {
			padding: 4.5rem 0;
		}
		.hm-hero {
			padding-top: 6.5rem;
		}
		.hm-portrait {
			max-width: none;
			aspect-ratio: 4 / 3;
		}
		.hm-row {
			padding-inline: 1.25rem;
		}
		.hm-row > .hm-card {
			flex-basis: 80vw;
		}
		.hm-thumb {
			aspect-ratio: 16 / 9;
		}
		.hm-big {
			padding: 5.5rem 0;
		}
		.hm-post {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hm-ch {
			animation: none;
			opacity: 1;
			transform: none;
		}
		.hm-dot,
		.hm-hint i,
		.hm-arrow {
			animation: none;
		}
		.hm-rv {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
		.hm-prog,
		.hm-hint {
			display: none;
		}
	}
</style>

<script>
	// Home-page motion. Re-initialised on every page load (Astro view transitions).
	let stop: (() => void) | null = null;

	function init() {
		stop?.();
		const root = document.getElementById("hm");
		if (!root) return;

		const ac = new AbortController();
		const { signal } = ac;
		const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

		const prog = document.getElementById("hm-prog")!;
		const heroText = document.getElementById("hm-hero-text")!;
		const portrait = document.getElementById("hm-portrait")!;
		const hint = document.getElementById("hm-hint")!;
		const sec = document.getElementById("works") as HTMLElement;
		const pin = document.getElementById("hm-pin") as HTMLElement;
		const row = document.getElementById("hm-row") as HTMLElement;
		const bar = document.getElementById("hm-bar") as HTMLElement;
		const cnt = document.getElementById("hm-cnt") as HTMLElement;
		const cards = Array.from(row.querySelectorAll<HTMLElement>(".hm-card"));
		const thumbs = Array.from(root.querySelectorAll<HTMLElement>(".hm-thumb span"));

		// reveal on scroll
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						e.target.classList.add("hm-in");
						io.unobserve(e.target);
					}
				}
			},
			{ threshold: 0.12 },
		);
		root.querySelectorAll<HTMLElement>(".hm-rv").forEach((el, i) => {
			el.style.transitionDelay = `${(i % 3) * 80}ms`;
			io.observe(el);
		});

		// pinned horizontal Works
		let pinned = false;
		let dist = 0;
		function layout() {
			pinned = !reduce && innerHeight >= 520;
			sec.classList.toggle("hm-on", pinned);
			if (!pinned) {
				sec.style.height = "";
				row.style.transform = "";
				return;
			}
			dist = Math.max(0, row.scrollWidth - innerWidth);
			sec.style.height = `${innerHeight + dist}px`;
		}
		function update() {
			const y = scrollY;
			const vh = innerHeight;
			const max = document.documentElement.scrollHeight - vh;
			prog.style.transform = `scaleX(${max > 0 ? y / max : 0})`;

			if (!reduce) {
				const k = Math.min(Math.max(y / (vh * 0.9), 0), 1);
				heroText.style.translate = `0 ${y * 0.25}px`;
				heroText.style.opacity = String(1 - k * 0.85);
				portrait.style.translate = `0 ${y * -0.08}px`;
				portrait.style.opacity = String(1 - k * 0.6);
				hint.style.opacity = String(Math.max(0, 1 - y / 120));
				for (const t of thumbs) {
					const r = t.parentElement!.getBoundingClientRect();
					if (r.bottom < 0 || r.top > vh || r.right < 0 || r.left > innerWidth) continue;
					t.style.translate = `0 ${((r.top + r.height / 2 - vh / 2) / vh) * -26}px`;
				}
			}

			if (pinned) {
				const room = sec.offsetHeight - vh;
				const p = room > 0 ? Math.min(1, Math.max(0, -sec.getBoundingClientRect().top / room)) : 0;
				row.style.transform = `translate3d(${-p * dist}px,0,0)`;
				bar.style.transform = `scaleX(${p})`;
				const n = Math.min(cards.length, Math.round(p * (cards.length - 1)) + 1);
				cnt.textContent = `${String(n).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
			}
		}

		// keyboard users: bring a focused card into view by scrolling the page
		for (const c of cards) {
			c.addEventListener(
				"focusin",
				() => {
					if (!pinned || dist <= 0) return;
					const room = sec.offsetHeight - innerHeight;
					const secTop = sec.getBoundingClientRect().top + scrollY;
					const target = Math.min(1, Math.max(0, (c.offsetLeft - 28) / dist));
					scrollTo({ top: secTop + target * room, behavior: reduce ? "auto" : "smooth" });
				},
				{ signal },
			);
		}
		pin.addEventListener("scroll", () => (pin.scrollLeft = 0), { signal });

		let ticking = false;
		addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(() => {
						ticking = false;
						update();
					});
				}
			},
			{ passive: true, signal },
		);
		addEventListener(
			"resize",
			() => {
				layout();
				update();
			},
			{ signal },
		);
		addEventListener("load", () => { layout(); update(); }, { signal });
		layout();
		update();

		stop = () => {
			ac.abort();
			io.disconnect();
			sec.style.height = "";
			stop = null;
		};
	}

	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", () => stop?.());
</script>
