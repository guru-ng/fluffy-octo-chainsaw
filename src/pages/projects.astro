---
import { projects } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "A selection of projects I've built — side projects, experiments, and work I'm proud of.",
	title: "Projects",
};

const stripes = ["var(--color-accent)", "var(--color-c3)", "var(--color-c4)", "var(--color-c5)"];
---

<PageLayout meta={meta}>
	<div class="mb-12">
		<h1 class="title mb-3">Projects</h1>
		<p class="text-mut mb-10 text-lg">
			Things I've built, am building, or find interesting enough to share.
		</p>

		<ul class="grid grid-cols-1 gap-6 sm:grid-cols-2" role="list">
			{
				projects.map((project, i) => (
					<li
						class="panel flex scroll-mt-28 flex-col gap-3 border-t-4 p-6"
						id={project.id}
						style={`border-top-color:${stripes[i % 4]}`}
					>
						<h2 class="text-accent-2 text-xl font-semibold">{project.title}</h2>
						<p class="flex-1 leading-relaxed">{project.description}</p>

						<div class="flex flex-wrap gap-2">
							{project.tags.map((t) => (
								<span class={`chip ${t.color ? `chip-${t.color}` : ""}`}>{t.label}</span>
							))}
						</div>

						<div class="flex gap-5 text-[15px]">
							{project.github && (
								<a
									class="cactus-link py-2"
									href={project.github}
									target="_blank"
									rel="noreferrer noopener"
								>
									GitHub ↗
								</a>
							)}
							{project.demo && (
								<a
									class="cactus-link py-2"
									href={project.demo}
									target="_blank"
									rel="noreferrer noopener"
								>
									Live demo ↗
								</a>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</PageLayout>
