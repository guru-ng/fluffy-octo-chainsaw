---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "A selection of projects I've built — side projects, experiments, and work I'm proud of.",
	title: "Projects",
};

interface Project {
	title: string;
	description: string;
	tech: string[];
	github?: string;
	demo?: string;
}

const projects: Project[] = [
	{
		title: "Portfolio — snjv.club",
		description:
			"This site. An Astro static site deployed on Cloudflare with a CI/CD pipeline: every git push builds and ships to production automatically. Custom domain, DNS, and edge hosting all on Cloudflare.",
		tech: ["Astro", "TypeScript", "Tailwind CSS", "Cloudflare"],
		github: "https://github.com/guru-ng/fluffy-octo-chainsaw",
		demo: "https://snjv.club",
	},
	{
		title: "Gorkhali Runners (in progress)",
		description:
			"A running community app where runners match each other's weekly distance. Planned: Strava API integration for automatic run syncing, leaderboards, and head-to-head distance challenges. Launching on a subdomain soon.",
		tech: ["Supabase", "Strava API", "TypeScript"],
	},
];
---

<PageLayout meta={meta}>
	<div class="mb-12">
		<h1 class="title mb-2">Projects</h1>
		<p class="text-gray-600 dark:text-gray-400 mb-10">
			Things I've built, am building, or find interesting enough to share.
		</p>

		<ul class="grid grid-cols-1 gap-6 sm:grid-cols-2" role="list">
			{
				projects.map((project) => (
					<li class="border-accent flex flex-col gap-3 rounded-lg border p-5">
						<h2 class="text-base font-semibold text-accent-2">{project.title}</h2>
						<p class="flex-1 text-sm leading-relaxed">{project.description}</p>

						<div class="flex flex-wrap gap-2">
							{project.tech.map((tag) => (
								<span class="bg-accent/10 rounded px-2 py-0.5 text-xs">{tag}</span>
							))}
						</div>

						<div class="flex gap-4 text-sm">
							{project.github && (
								<a
									class="cactus-link"
									href={project.github}
									target="_blank"
									rel="noreferrer noopener"
								>
									GitHub ↗
								</a>
							)}
							{project.demo && (
								<a
									class="cactus-link"
									href={project.demo}
									target="_blank"
									rel="noreferrer noopener"
								>
									Live demo ↗
								</a>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</PageLayout>
